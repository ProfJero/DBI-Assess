rules_version = '2';

// DBI Assess security rules.
// Students sign in with a custom token from the Worker (claims: role = "student", sid = Student ID).
// Admins sign in with email/password and have a document in /admins.
// Grading, attempts and certificates are written only by the Worker (service account, which bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isStudent() { return signedIn() && request.auth.token.role == 'student'; }
    function sid() { return request.auth.token.sid; }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Student profiles. Students may edit only their contact details.
    match /users/{uid} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStudent() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'email', 'school', 'community', 'bio', 'updatedAt']));
    }

    // Password hashes, login throttling and serial counters: Worker only.
    match /credentials/{id} { allow read, write: if false; }
    match /loginThrottle/{id} { allow read, write: if false; }
    match /counters/{id} { allow read: if isAdmin(); allow write: if false; }

    // Students see published (and closed) assessments in their list; questions come from the Worker.
    match /assessments/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.status in ['published', 'closed']);
      allow write: if isAdmin();
    }
    match /assessmentSecrets/{id} { allow read, write: if isAdmin(); }
    match /questions/{id} { allow read, write: if isAdmin(); }
    match /questionKeys/{id} { allow read, write: if isAdmin(); }

    // Attempts and results: only the Worker writes them, so scores cannot be forged.
    // Students read their own results through the Worker, which applies the release policy.
    match /studentResults/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /certificates/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == sid() && resource.data.status == 'issued');
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /emailLogs/{id} { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
